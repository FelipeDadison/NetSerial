{
  "name": "NetSerial",
  "version": "1.1.0",
  "description": "Multi-protocol Serial communication wrapper for ESP32 supporting TCP, WebSocket, and UDP transports with Arduino Stream interface",
  "keywords": [
    "serial",
    "communication",
    "tcp",
    "websocket",
    "udp",
    "esp32",
    "async",
    "networking"
  ],
  "authors": [
    {
      "name": "Felipe Dadison"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/FelipeDadison/NetSerial",
  "repository": {
    "type": "git",
    "url": "https://github.com/FelipeDadison/NetSerial.git"
  },
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "dependencies": [
    {
      "owner": "ESP32Async",
      "name": "AsyncTCP",
      "version": "^3.5.0"
    },
    {
      "owner": "ESP32Async",
      "name": "ESPAsyncWebServer",
      "version": "^3.12.1"
    }
  ],
  "build": {
    "srcDir": "src"
  }
}
